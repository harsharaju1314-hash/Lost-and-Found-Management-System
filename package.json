{
  "name": "lost-and-found-management-system",
  "version": "1.0.0",
  "description": "A realistic Lost & Found Management System web application with rule-based matching and claim verification workflows.",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "server:dev": "node --watch src/server.js",
    "client:dev": "vite",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "build": "vite build",
    "seed": "node src/database/seed.js",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.55.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "author": "Harsha Raju",
  "license": "MIT"
}
